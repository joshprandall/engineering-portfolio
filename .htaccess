# Conservative portfolio caching. HTML always revalidates; stable assets get
# short-to-moderate browser reuse. Feature guards keep unsupported Apache
# modules from breaking the site.
<IfModule mod_headers.c>
  <FilesMatch "\\.(?:html?)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\\.(?:css|js|mjs|json|svg|png|jpe?g|webp|ttf|woff2?)$">
    Header always set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\\.(?:mp4|webm|mp3|ogg|wav)$">
    Header always set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
